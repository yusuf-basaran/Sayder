# Bunlar tarayıcıya gönderilen PUBLIC değerlerdir. service_role/secret key kullanmayın.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Modern publishable key veya legacy anon key:
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
VITE_COMPANY_NAME=Atölye Mobilya
VITE_COMPANY_EMAIL=info@example.com
VITE_COMPANY_ADDRESS=Firma adresinizi buraya yazın
VITE_WORKING_HOURS=Pzt–Cmt 09.00–18.00
# Ülke koduyla, yalnızca rakamlar (örnek: 905xxxxxxxxx)
VITE_WHATSAPP_NUMBER=
# Sadece yerel tasarım incelemesi için true; production'da false.
VITE_DEMO_MODE=false
